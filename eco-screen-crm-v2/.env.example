VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public same-origin route for an approved TikTok comment provider. Never place provider secrets in VITE_ variables.
VITE_TIKTOK_SCAN_ENDPOINT=
# Public same-origin routes only. Keep Meta, Facebook and RedNote credentials on the connector server.
VITE_FACEBOOK_SCAN_ENDPOINT=/api/meta/comments
VITE_REDNOTE_SCAN_ENDPOINT=

# Server-side only: approved Meta Page OAuth and Webhooks. Never prefix these with VITE_ or expose their values to the browser.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_GRAPH_API_VERSION=
META_STATE_SECRET=
META_TOKEN_ENCRYPTION_KEY=
META_WEBHOOK_VERIFY_TOKEN=
PUBLIC_APP_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy server-key fallback (optional when SUPABASE_SECRET_KEY is set)
SUPABASE_SERVICE_ROLE_KEY=
